#!/usr/bin/env python3
"""Git commit-msg hook for every repo under Developing/: the subject must follow the commit convention."""
import subprocess
import sys
from pathlib import Path

WORKSPACE = Path(__file__).resolve().parents[1]
VENV_PYTHON = WORKSPACE / ".venv" / "bin" / "python"
PYTHON = str(VENV_PYTHON) if VENV_PYTHON.exists() else sys.executable
CHECK = WORKSPACE / "scripts" / "hooks" / "commit_msg.py"
sys.exit(subprocess.call([PYTHON, str(CHECK), sys.argv[1]]))
